{
  "name": "supplement-stack-app",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-graded supplement stack checker (prototype).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate-data.mjs",
    "validate:strict": "node scripts/validate-data.mjs --strict",
    "evidence:fetch": "NODE_USE_ENV_PROXY=1 node scripts/evidence.mjs fetch",
    "evidence:verify": "NODE_USE_ENV_PROXY=1 node scripts/evidence.mjs verify",
    "kb": "node scripts/build-kb.mjs",
    "dev": "npm run kb && vite",
    "build": "npm run kb && tsc -p . && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "js-yaml": "^4.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/newsreader": "^5.1.0",
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@fontsource/ibm-plex-sans": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
